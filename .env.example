# Copia este archivo como .env.local para probar en tu computadora.
# En producción, estas variables se ponen en Vercel: Settings → Environment Variables.
# Nunca subas la clave real a GitHub.

# Requerida. Se crea en https://resend.com/api-keys
RESEND_API_KEY=re_tu_clave_aqui

# Opcional. Correo donde llegan los mensajes del formulario (por defecto: flowtech025@gmail.com).
CONTACT_TO_EMAIL=flowtech025@gmail.com

# Opcional. Remitente del email. onboarding@resend.dev solo puede enviar al correo de tu cuenta de Resend.
# Con un dominio verificado en Resend, usa algo como: FlowTech <contacto@tudominio.com>
CONTACT_FROM_EMAIL=FlowTech <onboarding@resend.dev>
